<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>app.goodbuy</groupId>
  <artifactId>goodbuy-backend</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>
  <name>GoodBuy Backend (Parent)</name>

  <properties>
    <java.version>17</java.version>
    <spring.boot.version>3.3.3</spring.boot.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>${java.version}</maven.compiler.release>
  </properties>

  <!-- Multi-module layout -->
  <modules>
    <module>goodbuy-core</module>
    <module>goodbuy-adapters-core</module>
    <module>goodbuy-adapters-catalog</module>
    <module>goodbuy-api</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <!-- Spring Boot BOM: manages Spring & friends -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring.boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- ✅ AWS SDK v2 BOM: central version for all software.amazon.awssdk:* deps -->
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>2.29.20</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- Internal modules: single source of truth for versions -->
      <dependency>
        <groupId>app.goodbuy</groupId>
        <artifactId>goodbuy-core</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>app.goodbuy</groupId>
        <artifactId>goodbuy-adapters-core</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>app.goodbuy</groupId>
        <artifactId>goodbuy-adapters-catalog</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <!-- Use Java 17 across all modules -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.11.0</version>
          <configuration>
            <release>${java.version}</release>
          </configuration>
        </plugin>

        <!-- Spring Boot plugin (for goodbuy-api) -->
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring.boot.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

</project>
