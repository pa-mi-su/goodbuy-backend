<!-- src/main/resources/logback-spring.xml -->
<configuration>
    <!-- Active Spring profile -->
    <springProperty scope="context" name="activeProfile" source="spring.profiles.active" defaultValue="dev"/>

    <!-- Plain console (readable) -->
    <appender name="PLAIN" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %logger{36} reqId=%X{requestId} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- JSON console (for prod-json profile) -->
    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <fieldNames>
                <timestamp>ts</timestamp>
                <level>level</level>
                <logger>logger</logger>
                <thread>thread</thread>
                <message>msg</message>
            </fieldNames>
            <customFields>{"app":"goodbuy-api"}</customFields>
        </encoder>
    </appender>

    <!-- Default root: plain everywhere -->
    <root level="INFO">
        <appender-ref ref="PLAIN"/>
    </root>

    <!-- Dev: make our package more chatty -->
    <springProfile name="dev">
        <logger name="app.goodbuy" level="DEBUG"/>
        <logger name="app.goodbuy.catalog" level="DEBUG"/>
        <logger name="app.goodbuy.catalog.eandb" level="DEBUG"/>
    </springProfile>

    <!-- Prod: quieter base; still plain by default -->
    <springProfile name="prod">
        <logger name="app.goodbuy" level="INFO"/>
        <logger name="app.goodbuy.catalog" level="INFO"/>
        <logger name="org.springframework" level="INFO"/>
    </springProfile>

    <!-- Optional: switch to JSON by adding 'prod-json' to SPRING_PROFILES_ACTIVE -->
    <springProfile name="prod-json">
        <root level="INFO">
            <appender-ref ref="JSON"/>
        </root>
    </springProfile>
</configuration>
